#define COsensorThere  true
// [SUPERSEDED v2.4] IMUsensorThere (JY-901 UART) removed. BMI160sensorThere
// below now gates the ONLY IMU in the system — both inertial nav AND the
// Roll/Pitch/Yaw/temp feeding V8-V11.
